NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-public-vapid-key

# Server-only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_SUBJECT=mailto:alerts@example.com
CRON_SECRET=replace-with-long-random-cron-secret
